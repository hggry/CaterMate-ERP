# ============================================================
# Vorlage — kopiere diese Datei nach .env und trage deine Werte ein:
#   cp .env.example .env
# .env ist gitignored und wird nie committet.
# ============================================================

# ============================================================
# Datenbank
# ============================================================
DB_ROOT_PASSWORD=change_me
DB_NAME=catermate_db
DB_USER=catermate_user
DB_PASSWORD=change_me
DB_PORT=3306

# ============================================================
# Backend (ASP.NET Web API)
# ============================================================
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5000

JWT_SECRET=change_me_min_32_characters_long
JWT_ISSUER=catermate
JWT_EXPIRY_HOURS=8

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me

# ============================================================
# Frontend (Vue 3 + Vite)
# ============================================================
FRONTEND_PORT=3000

# ============================================================
# n8n
# ============================================================
N8N_PORT=5678
N8N_USER=admin
N8N_PASSWORD=change_me
N8N_DB_PASSWORD=change_me
N8N_ENCRYPTION_KEY=change_me_long_random_string_min_32_chars
WEBHOOK_URL=https://your-ngrok-domain.ngrok-free.app

# Persönlicher ngrok-Authtoken — https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ============================================================
# Allgemein
# ============================================================
TIMEZONE=Europe/Vienna
